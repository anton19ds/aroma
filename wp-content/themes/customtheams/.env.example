# Параметры почтового сервера для формы обратной связи
# Скопируйте в .env и заполните своими данными

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yoursite.com
MAIL_FROM_NAME=Сайт Aroma

# Email, на который приходят заявки с формы
CONTACT_FORM_TO=admin@yoursite.com

# Telegram: уведомления о новых заказах
# Создайте бота через @BotFather, получите токен. Chat ID — ID чата/группы куда слать сообщения
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890
